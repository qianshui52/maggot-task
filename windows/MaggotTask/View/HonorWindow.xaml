<Window x:Class="MaggotTask.View.HonorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="荣誉殿堂"
        Width="760"
        Height="780"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <Grid Margin="18">
        <Border CornerRadius="22" Background="#66000000" Margin="0,8,0,0">
            <Border.Effect>
                <BlurEffect Radius="20" RenderingBias="Quality" />
            </Border.Effect>
        </Border>

        <Border Background="{StaticResource DeepBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 标题 -->
                <Grid Grid.Row="0" Margin="20,16,16,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="荣誉殿堂" Style="{StaticResource TextH1}" />
                        <Border Background="{StaticResource SurfaceHiBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8" Padding="8,3" Margin="10,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding MedalCountText}"
                                       Style="{StaticResource TextData}" />
                        </Border>
                    </StackPanel>

                    <Button Content="关闭" Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            MinWidth="56" MinHeight="32" Padding="10,0"
                            Click="OnCloseClick" />
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource HairLine}" Margin="20,0,20,0" />

                <!-- 唯一滚动面 -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="16,14,16,0">
                    <StackPanel>

                        <!-- ============ 连胜卡片 ============ -->
                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="18,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StreakText}"
                                               Style="{StaticResource TextDisplay}"
                                               Foreground="{StaticResource PrimaryBrush}" />
                                    <TextBlock Text="连续打卡（天）"
                                               Style="{StaticResource TextLabel}"
                                               Margin="2,0,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="26,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="热度 " Style="{StaticResource TextLabel}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding HeatLabel}"
                                                   Style="{StaticResource TextDataStrong}"
                                                   Foreground="{StaticResource WarnBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding HeatFlames}"
                                                   FontSize="14"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding StreakHint}"
                                               Style="{StaticResource TextBodyMuted}"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding BestText}"
                                               Style="{StaticResource TextDataStrong}"
                                               HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding TodayText}"
                                               Style="{StaticResource TextData}"
                                               HorizontalAlignment="Right"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- ============ 连胜日历 ============ -->
                        <TextBlock Text="连胜日历"
                                   Style="{StaticResource TextH2}"
                                   Margin="4,20,0,2" />
                        <TextBlock Text="最后 5 周。颜色越亮，当天清掉的虫子越多。"
                                   Style="{StaticResource TextData}"
                                   Foreground="{StaticResource FgMutedBrush}"
                                   Margin="4,0,0,10" />

                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="14,12">
                            <StackPanel>
                                <Grid x:Name="WeekdayHeader" Margin="0,0,0,6" />
                                <UniformGrid x:Name="CalendarGrid" Columns="7" />
                            </StackPanel>
                        </Border>

                        <!-- ============ 勋章墙 ============ -->
                        <TextBlock Text="勋章墙"
                                   Style="{StaticResource TextH2}"
                                   Margin="4,20,0,2" />
                        <TextBlock Text="十枚勋章，全部来自打卡与击杀。灰色的是还没拿到的。"
                                   Style="{StaticResource TextData}"
                                   Foreground="{StaticResource FgMutedBrush}"
                                   Margin="4,0,0,10" />

                        <ItemsControl ItemsSource="{Binding Medals}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            Padding="14,12"
                                            Margin="0,0,10,10"
                                            Opacity="{Binding CardOpacity}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Width="44" Height="44"
                                                    CornerRadius="22"
                                                    Background="{Binding BadgeBackground}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Glyph}"
                                                           FontSize="19"
                                                           FontWeight="Bold"
                                                           Foreground="{Binding GlyphBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                <TextBlock Text="{Binding Name}"
                                                           Style="{StaticResource TextDataStrong}"
                                                           FontSize="14" />
                                                <TextBlock Text="{Binding Description}"
                                                           Style="{StaticResource TextBodyMuted}"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"
                                                           Margin="0,3,0,0" />

                                                <Grid Margin="0,8,0,0" HorizontalAlignment="Left">
                                                    <Border Width="150" Height="5" CornerRadius="3"
                                                            Background="{StaticResource TrackBrush}" />
                                                    <Border Width="{Binding BarWidth}" Height="5" CornerRadius="3"
                                                            HorizontalAlignment="Left"
                                                            Background="{Binding BarBrush}" />
                                                </Grid>

                                                <TextBlock Text="{Binding ProgressText}"
                                                           Style="{StaticResource TextData}"
                                                           Foreground="{StaticResource FgSubtleBrush}"
                                                           Margin="0,5,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Height="6" />
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="3" Style="{StaticResource HairLine}" Margin="20,12,20,0" />
                <TextBlock Grid.Row="3"
                           Text="{Binding FooterText}"
                           Style="{StaticResource TextData}"
                           Margin="20,10,20,16"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </Grid>
</Window>
