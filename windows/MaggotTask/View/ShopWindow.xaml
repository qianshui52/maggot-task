<Window x:Class="MaggotTask.View.ShopWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="军械库"
        Width="560"
        Height="700"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <Grid Margin="18">
        <Border CornerRadius="22" Background="#66000000" Margin="0,8,0,0">
            <Border.Effect>
                <BlurEffect Radius="20" RenderingBias="Quality" />
            </Border.Effect>
        </Border>

        <Border Background="{StaticResource DeepBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 标题行 -->
                <Grid Grid.Row="0" Margin="20,16,16,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="军械库" Style="{StaticResource TextH1}" />
                        <Border Background="{StaticResource PrimarySoftBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8" Padding="8,3" Margin="10,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding CoinText}"
                                       Style="{StaticResource TextDataStrong}"
                                       Foreground="#FFF5C542" />
                        </Border>
                    </StackPanel>

                    <Button Content="关闭" Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            MinWidth="56" MinHeight="32" Padding="10,0"
                            Click="OnCloseClick" />
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource HairLine}" Margin="20,0,20,0" />

                <!-- 工具列表（单一滚动面） -->
                <ScrollViewer x:Name="BodyScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="16,14,16,0">
                    <StackPanel>
                        <TextBlock Text="击杀奖励固定：卵 100 · 蛆 50 · 蛹 25 · 苍蝇 10。进阶工具不改变奖励，只扩大一次能清掉的范围。"
                                   Style="{StaticResource TextBodyMuted}"
                                   TextWrapping="Wrap"
                                   Margin="4,0,4,12" />

                        <ItemsControl ItemsSource="{Binding Cards}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            Padding="14,12"
                                            Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="8" Height="8" CornerRadius="4"
                                                            Background="{Binding AccentBrush}"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,7,0" />
                                                    <TextBlock Text="{Binding Name}"
                                                               Style="{StaticResource TextH2}" />
                                                    <Border Background="{StaticResource SurfaceHiBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="6,1"
                                                            Margin="8,0,0,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Badge}"
                                                                   Style="{StaticResource TextLabel}"
                                                                   Foreground="{StaticResource FgMutedBrush}" />
                                                    </Border>
                                                </StackPanel>

                                                <TextBlock Text="{Binding Subtitle}"
                                                           Style="{StaticResource TextData}"
                                                           Foreground="{StaticResource FgMutedBrush}"
                                                           Margin="0,4,0,0" />

                                                <TextBlock Text="{Binding Description}"
                                                           Style="{StaticResource TextBodyMuted}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,6,0,0" />

                                                <TextBlock Text="{Binding PriceText}"
                                                           Style="{StaticResource TextDataStrong}"
                                                           Foreground="#FFF5C542"
                                                           Margin="0,8,0,0" />
                                            </StackPanel>

                                            <Button Grid.Column="1"
                                                    Content="{Binding ActionText}"
                                                    Command="{Binding Action}"
                                                    IsEnabled="{Binding CanAct}"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Width="96" Height="38"
                                                    VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- 底部：当前装备 + 提示 -->
                <Border Grid.Row="3" Style="{StaticResource HairLine}" Margin="20,12,20,0" />
                <TextBlock Grid.Row="3"
                           Text="{Binding FooterText}"
                           Style="{StaticResource TextData}"
                           Margin="20,10,20,16"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </Grid>
</Window>
