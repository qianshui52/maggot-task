<Window x:Class="MaggotTask.View.NameTagWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        IsHitTestVisible="False"
        Topmost="True"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <!-- 悬停名牌：光标旁边的一行小字。不接收命中测试、不抢焦点。 -->
    <Border x:Name="Shell"
            Background="#F00C100A"
            BorderBrush="#FF3B4A32"
            BorderThickness="1"
            CornerRadius="9"
            Padding="9,5"
            Margin="6">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2"
                              Direction="270" Opacity="0.55" />
        </Border.Effect>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border x:Name="StageDot" Width="7" Height="7" CornerRadius="4"
                    VerticalAlignment="Center" Margin="0,0,6,0" />

            <TextBlock x:Name="TitleText"
                       Text="任务名"
                       FontFamily="{StaticResource DisplayFont}"
                       FontSize="12.5"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource FgBrush}"
                       MaxWidth="240"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />

            <TextBlock x:Name="StageText"
                       Text="苍蝇"
                       FontFamily="{StaticResource MonoFont}"
                       FontSize="10.5"
                       Foreground="{StaticResource FgMutedBrush}"
                       Margin="7,0,0,0"
                       VerticalAlignment="Center" />

            <TextBlock x:Name="RewardText"
                       Text="+10"
                       FontFamily="{StaticResource MonoFont}"
                       FontSize="11.5"
                       FontWeight="Bold"
                       Foreground="#FFF5C542"
                       Margin="7,0,0,0"
                       VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</Window>
