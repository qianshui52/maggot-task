<Window x:Class="MaggotTask.View.TaskListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:MaggotTask.View"
        Title="蛆虫任务 · 任务列表"
        Width="500"
        Height="640"
        MinWidth="420"
        MinHeight="380"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <v:StageBrushConverter x:Key="StageBrush" />
        <v:RotBrushConverter x:Key="RotBrush" />
        <v:RotToRatioConverter x:Key="RotToRatio" />
        <v:RotToTextConverter x:Key="RotToText" />
        <v:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="16">
        <Border CornerRadius="24" Background="#66000000" Margin="0,8,0,0">
            <Border.Effect>
                <BlurEffect Radius="18" RenderingBias="Quality" />
            </Border.Effect>
        </Border>

        <Border Background="{StaticResource DeepBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />   <!-- 标题行（固定） -->
                    <RowDefinition Height="*" />      <!-- 单一总滚动区：新建/模板/任务/战果 -->
                    <RowDefinition Height="Auto" />   <!-- 底部统计 + 关闭（固定） -->
                </Grid.RowDefinitions>

                <!-- ============ 标题行 ============ -->
                <Border Grid.Row="0"
                        Background="Transparent"
                        MouseLeftButtonDown="OnDragHandleMouseDown"
                        Cursor="SizeAll"
                        ToolTip="按住拖动窗口">
                    <Grid Margin="20,10,12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="任务列表" Style="{StaticResource TextH1}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding HeaderCountText}" Style="{StaticResource TextLabel}"
                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <!-- ⚠️ 收起按钮必须在标题行常驻：任务多时窗口底部会被内容顶出屏幕外，
                             底部的「关闭」够不着，用户就再也收不起这个窗口了。 -->
                        <Button Grid.Column="1"
                                Content="收起 ✕"
                                Style="{StaticResource GhostButton}"
                                MinWidth="72" Height="36" MinHeight="36"
                                VerticalAlignment="Center"
                                Click="OnCloseClick"
                                ToolTip="收起任务列表（Esc 也可以）" />
                    </Grid>
                </Border>

                <Border Grid.Row="0" Style="{StaticResource HairLine}" VerticalAlignment="Bottom" Margin="20,0,20,0" />

                <!-- ============ 单一总滚动区（1.2.10 同款教训：一个页面只允许一个滚动面） ============ -->
                <ScrollViewer x:Name="MainScroll" Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                <!-- ============ 新建任务 ============ -->
                <Grid Margin="20,16,20,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="NewTaskBox"
                             Grid.Column="0"
                             Style="{StaticResource MaggotTextBox}"
                             MaxLength="80"
                             KeyDown="OnNewTaskKeyDown"
                             ToolTip="输入任务标题后按回车；中文输入法按回车会先上屏，再按一次回车创建" />

                    <Button Grid.Column="2"
                            Content="新建"
                            Style="{StaticResource PrimaryButton}"
                            MinWidth="88"
                            Click="OnCreateTaskClick" />
                </Grid>

                <!-- ============ 每日任务模板（规格 §12.4） ============ -->
                <Expander
                          Style="{StaticResource MaggotExpander}"
                          Margin="20,10,20,0"
                          IsExpanded="True">
                    <Expander.Header>
                        <TextBlock Text="{Binding DailyHeaderText}"
                                   Style="{StaticResource TextH2}"
                                   Foreground="{StaticResource FgMutedBrush}"
                                   VerticalAlignment="Center" />
                    </Expander.Header>

                    <!-- 模板行全量渲染：总滚动区已保证可达性，不再各自套滚动。 -->
                    <StackPanel>
                        <!-- 新增模板 -->
                        <Grid Margin="0,8,8,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="NewDailyBox"
                                     Grid.Column="0"
                                     Style="{StaticResource MaggotTextBox}"
                                     MaxLength="80"
                                     KeyDown="OnNewDailyKeyDown"
                                     ToolTip="每天自动生成一个新实例的模板；输入标题后按回车" />
                            <Button Grid.Column="2"
                                    Content="新增模板"
                                    Style="{StaticResource BaseButton}"
                                    MinWidth="96" Height="44"
                                    Click="OnAddDailyClick" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding DailyRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RSm}"
                                            Margin="0,4,8,4"
                                            Opacity="{Binding RowOpacity}">
                                        <Grid Margin="12,8,10,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- 启用开关（停用后不再生成新实例，已有实例照常烂） -->
                                            <Button Grid.Column="0"
                                                    Content="{Binding SummaryText}"
                                                    Style="{StaticResource GhostButton}"
                                                    Height="32" MinHeight="32" MinWidth="150"
                                                    Padding="10,0" FontSize="12"
                                                    Command="{Binding ToggleCommand}"
                                                    ToolTip="点击启用 / 停用该模板（已有实例不受影响）" />

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Title}"
                                                       Style="{StaticResource TextBody}"
                                                       Margin="10,0,10,0"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"
                                                       ToolTip="{Binding Title}" />

                                            <!-- 今天实例的状态：未生成 / 卵 / 蛆 / 蛹 / 苍蝇 / 已完成 -->
                                            <Border Grid.Column="2"
                                                    Background="{StaticResource SurfaceHiBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="999"
                                                    Padding="9,3"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,8,0">
                                                <TextBlock Text="{Binding TodayChipText}"
                                                           Style="{StaticResource TextLabel}" />
                                            </Border>

                                            <Button Grid.Column="3"
                                                    Content="删除"
                                                    Style="{StaticResource DangerButton}"
                                                    Height="32" MinHeight="32" MinWidth="52"
                                                    Padding="10,0" FontSize="12"
                                                    Command="{Binding DeleteCommand}"
                                                    ToolTip="删除模板；已生成的实例保留，退化成普通任务继续腐烂" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="还没有模板。写一条每天都要做的事 —— 每天会自动出现一只新虫。"
                                   Style="{StaticResource TextBodyMuted}"
                                   Margin="0,6,8,6"
                                   FontSize="13"
                                   Visibility="{Binding HasNoDaily, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Expander>

                <!-- ============ 每周任务模板（规格 §15.5 → §12.4） ============ -->
                <Expander
                          Style="{StaticResource MaggotExpander}"
                          Margin="20,8,20,0"
                          IsExpanded="True">
                    <Expander.Header>
                        <TextBlock Text="{Binding WeeklyHeaderText}"
                                   Style="{StaticResource TextH2}"
                                   Foreground="{StaticResource FgMutedBrush}"
                                   VerticalAlignment="Center" />
                    </Expander.Header>

                    <!-- 同每日区：全量渲染，交给总滚动区。 -->
                    <StackPanel>
                        <!-- 新增模板 + 星期几选择 -->
                        <Grid Margin="0,8,8,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="NewWeeklyBox"
                                     Grid.Column="0"
                                     Style="{StaticResource MaggotTextBox}"
                                     MaxLength="80"
                                     KeyDown="OnNewWeeklyKeyDown"
                                     ToolTip="每周固定某天自动生成一个新实例的模板；输入标题后按回车" />
                            <Button x:Name="WeekdayButton"
                                    Grid.Column="2"
                                    Content="周一"
                                    Style="{StaticResource GhostButton}"
                                    MinWidth="96" Height="44" MinHeight="44"
                                    Padding="10,0" FontSize="13"
                                    Click="OnPickWeekdayClick"
                                    ToolTip="点击切换星期几：周一 → 周日（实例在这一天或之后生成）" />
                            <Button Grid.Column="4"
                                    Content="新增模板"
                                    Style="{StaticResource BaseButton}"
                                    MinWidth="96" Height="44"
                                    Click="OnAddWeeklyClick" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding WeeklyRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RSm}"
                                            Margin="0,4,8,4"
                                            Opacity="{Binding RowOpacity}">
                                        <Grid Margin="10,8,10,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- 星期几（规格 §15.2 的 weekday，ISO 1=周一..7=周日） -->
                                            <Border Grid.Column="0"
                                                    Background="{StaticResource SurfaceHiBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="999"
                                                    Padding="8,3"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding WeekdayLabel}"
                                                           Style="{StaticResource TextLabel}" />
                                            </Border>

                                            <!-- 启用开关（停用后不再生成新实例，已有实例照常烂） -->
                                            <Button Grid.Column="1"
                                                    Content="{Binding SummaryText}"
                                                    Style="{StaticResource GhostButton}"
                                                    Height="32" MinHeight="32" MinWidth="118"
                                                    Padding="10,0" FontSize="12" Margin="8,0,0,0"
                                                    Command="{Binding ToggleCommand}"
                                                    ToolTip="点击启用 / 停用该模板（已有实例不受影响）" />

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Title}"
                                                       Style="{StaticResource TextBody}"
                                                       Margin="10,0,10,0"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"
                                                       ToolTip="{Binding Title}" />

                                            <!-- 本周实例的状态：未生成 / 卵 / 蛆 / 蛹 / 苍蝇 / 已完成 -->
                                            <Border Grid.Column="3"
                                                    Background="{StaticResource SurfaceHiBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="999"
                                                    Padding="9,3"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,8,0">
                                                <TextBlock Text="{Binding ThisWeekChipText}"
                                                           Style="{StaticResource TextLabel}" />
                                            </Border>

                                            <Button Grid.Column="4"
                                                    Content="删除"
                                                    Style="{StaticResource DangerButton}"
                                                    Height="32" MinHeight="32" MinWidth="52"
                                                    Padding="10,0" FontSize="12"
                                                    Command="{Binding DeleteCommand}"
                                                    ToolTip="删除模板；已生成的实例保留，退化成普通任务继续腐烂" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="还没有模板。写一条每周固定要做的事 —— 到那天会自动出现一只新虫；漏掉的会在界面上一直标着「已逾期 N 周」。"
                                   Style="{StaticResource TextBodyMuted}"
                                   Margin="0,6,8,6"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasNoWeekly, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Expander>

                <!-- ============ 任务列表（完成按钮在这里：我去做了 / 完成 / 删除） ============ -->
                <StackPanel Margin="12,8,12,0">
                        <ItemsControl ItemsSource="{Binding ActiveRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RMd}"
                                            Margin="4,4,8,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- 阶段色竖条 -->
                                            <Rectangle Grid.Column="0" Fill="{Binding StageBrush}" />

                                            <Grid Grid.Column="1" Margin="13,10,10,10">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- 标题 + 右侧动作 -->
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Title}"
                                                               Style="{StaticResource TextBody}"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextWrapping="NoWrap"
                                                               VerticalAlignment="Center"
                                                               ToolTip="{Binding Title}" />

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <!-- 逾期标记（规格 §12.1 每日「已逾期 N 天」/ §15.5 每周「已逾期 N 周」） -->
                                                        <Border Background="{StaticResource DangerSoftBrush}"
                                                                BorderBrush="{StaticResource DangerBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="999"
                                                                Padding="9,3"
                                                                Margin="0,0,8,0"
                                                                VerticalAlignment="Center"
                                                                Visibility="{Binding IsOverdue, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="{Binding OverdueText}"
                                                                       Style="{StaticResource TextLabel}"
                                                                       Foreground="{StaticResource DangerBrush}" />
                                                        </Border>
                                                        <Button Content="我去做了"
                                                                Style="{StaticResource PrimaryOutlinedButton}"
                                                                Height="44" MinHeight="44"
                                                                MinWidth="80" Padding="10,0"
                                                                FontSize="13"
                                                                Command="{Binding CareCommand}" />
                                                        <Button Content="完成"
                                                                Style="{StaticResource SuccessButton}"
                                                                Height="44" MinHeight="44"
                                                                MinWidth="56" Padding="10,0"
                                                                FontSize="13"
                                                                Margin="8,0,0,0"
                                                                Command="{Binding CompleteCommand}" />
                                                        <Button Content="删除"
                                                                Style="{StaticResource DangerButton}"
                                                                Height="44" MinHeight="44"
                                                                MinWidth="56" Padding="10,0"
                                                                FontSize="13"
                                                                Margin="8,0,0,0"
                                                                Command="{Binding DeleteCommand}" />
                                                    </StackPanel>
                                                </Grid>

                                                <!-- chip + rot 进度条 + 剩余时间 -->
                                                <Grid Grid.Row="1" Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- 阶段 chip：色点 + 大写代号 + 中文名 -->
                                                    <Border Grid.Column="0"
                                                            Background="{StaticResource SurfaceHiBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="999"
                                                            Padding="9,3">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                                                     Fill="{Binding StageBrush}" />
                                                            <TextBlock Text="{Binding StageCode}"
                                                                       Style="{StaticResource TextLabel}"
                                                                       Foreground="{StaticResource FgMutedBrush}"
                                                                       Margin="6,0,0,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding StageLabel}"
                                                                       Style="{StaticResource TextLabel}"
                                                                       Margin="6,0,0,0" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- rot 进度条 -->
                                                    <Border Grid.Column="1"
                                                            Height="4" CornerRadius="2"
                                                            Margin="10,0,10,0"
                                                            VerticalAlignment="Center"
                                                            Background="{StaticResource TrackBrush}"
                                                            ClipToBounds="True">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="{Binding Rot, Converter={StaticResource RotToRatio}}" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Rectangle Grid.Column="0" RadiusX="2" RadiusY="2"
                                                                       Fill="{Binding Rot, Converter={StaticResource RotBrush}}" />
                                                        </Grid>
                                                    </Border>

                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Remaining}"
                                                               Style="{StaticResource TextData}"
                                                               VerticalAlignment="Center" />
                                                </Grid>

                                                <!-- 实验记录式副标题 -->
                                                <TextBlock Grid.Row="2"
                                                           Text="{Binding MetaText}"
                                                           Style="{StaticResource TextLabel}"
                                                           Margin="0,6,0,0" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="还没有任务。写上你要拖的事 —— 它会开始烂。"
                                   Style="{StaticResource TextBodyMuted}"
                                   Margin="12,20,12,20"
                                   Visibility="{Binding HasNoTasks, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                <!--
                  ============ 标本缸 ============
                  已击杀的虫子**不再逐条列出**：全倒进同一口缸里，按阶段分四格。
                  数量直接显示，鼠标悬停给出该类的完整说明（以及每只值多少货币）。
                -->
                <Border Style="{StaticResource PanelCard}"
                        Background="{StaticResource SurfaceBrush}"
                        Margin="20,8,20,0"
                        Padding="14,12"
                        ToolTip="{Binding SpecimenSummaryTip}">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="标本缸" Style="{StaticResource TextH2}"
                                           Foreground="{StaticResource FgSubtleBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SpecimenTotalText}"
                                           Style="{StaticResource TextLabel}"
                                           Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="悬停看分类"
                                       Style="{StaticResource TextLabel}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Background="Transparent"
                                        ToolTip="{Binding SpecimenEggTip}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                             Fill="{StaticResource EggBrush}" />
                                    <TextBlock Text="卵" Style="{StaticResource TextLabel}"
                                               Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding SpecimenEgg}"
                                           Style="{StaticResource TextDataStrong}"
                                           FontSize="18" HorizontalAlignment="Center" Margin="0,3,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Background="Transparent"
                                        ToolTip="{Binding SpecimenLarvaTip}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                             Fill="{StaticResource LarvaBrush}" />
                                    <TextBlock Text="蛆" Style="{StaticResource TextLabel}"
                                               Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding SpecimenLarva}"
                                           Style="{StaticResource TextDataStrong}"
                                           FontSize="18" HorizontalAlignment="Center" Margin="0,3,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Background="Transparent"
                                        ToolTip="{Binding SpecimenPupaTip}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                             Fill="{StaticResource PupaBrush}" />
                                    <TextBlock Text="蛹" Style="{StaticResource TextLabel}"
                                               Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding SpecimenPupa}"
                                           Style="{StaticResource TextDataStrong}"
                                           FontSize="18" HorizontalAlignment="Center" Margin="0,3,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="3" Background="Transparent"
                                        ToolTip="{Binding SpecimenFlyTip}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                             Fill="{StaticResource FlyRimBrush}" />
                                    <TextBlock Text="苍蝇" Style="{StaticResource TextLabel}"
                                               Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding SpecimenFly}"
                                           Style="{StaticResource TextDataStrong}"
                                           FontSize="18" HorizontalAlignment="Center" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                </StackPanel>
                </ScrollViewer>

                <!-- ============ 底部统计（固定，不随滚动） ============ -->
                <StackPanel Grid.Row="2">
                    <Border Style="{StaticResource HairLine}" Margin="20,12,20,0" />
                    <Grid Margin="20,10,20,16">
                        <TextBlock Text="{Binding FooterText}" Style="{StaticResource TextData}"
                                   HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <Button Content="关闭" Style="{StaticResource GhostButton}"
                                MinWidth="88" Height="44" MinHeight="44"
                                HorizontalAlignment="Right"
                                Click="OnCloseClick" />
                    </Grid>
                    <!-- 字体预热（见 ControlPanelWindow.xaml 的说明） -->
                    <TextBlock x:Name="FontWarmup"
                               Text="蝇卵 · 战果 · 腐化倍速 · 剩余时间"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="15"
                               Width="0" Height="0"
                               Opacity="0"
                               IsHitTestVisible="False"
                               Focusable="False" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
