<Window x:Class="MaggotTask.View.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认"
        Width="420"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterOwner"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Grid Margin="16">
        <Border CornerRadius="24" Background="#77000000" Margin="0,8,0,0">
            <Border.Effect>
                <BlurEffect Radius="16" RenderingBias="Quality" />
            </Border.Effect>
        </Border>

        <Border Background="{StaticResource DeepBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="24">
            <StackPanel Margin="24,20,24,20" MinWidth="320">
                <TextBlock x:Name="TitleText"
                           Style="{StaticResource TextH2}"
                           TextWrapping="Wrap" />

                <TextBlock x:Name="BodyText"
                           Style="{StaticResource TextBodyMuted}"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0" />

                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="CancelButton"
                            Grid.Column="0"
                            Content="取消"
                            Style="{StaticResource GhostButton}"
                            Height="44"
                            Click="OnCancelClick"
                            IsCancel="True" />

                    <Button x:Name="OkButton"
                            Grid.Column="2"
                            Content="确认"
                            Style="{StaticResource DangerButton}"
                            Height="44"
                            Click="OnOkClick"
                            IsDefault="True" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
